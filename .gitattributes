# Keep prepared upstream patches byte-exact so git am applies them.
*.patch -text

# Windows batch files misparse labels with LF-only endings; always check them out CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Docs stay LF on every machine, so one edit on Windows never rewrites a whole file (HANDOFF.md did, 9f928fe).
*.md text eol=lf
