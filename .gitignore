# Godot
.godot/
*.import
export.cfg
export_presets.cfg

# Python
harness_data/.venv/
__pycache__/
*.pyc

# Vendored agent skills (fetched by setup.bat)
harness_data/vendor/

# Local secrets & runtime
harness_data/.env
*.token
*.log

# Test output created by the agent
scenes/
scripts/
cloud/.env

# Cloud runtime state (never commit - holds session tokens)
cloud/sessions.json

# Harness runtime state
harness_data/loki_settings.json
harness_data/loki_claude_mcp.json
.git-rewrite/

# Harness user data (memory + plan written at runtime)
harness_data/memory.md
harness_data/plan.md
harness_data/workspace/

# Godot API dump (generated on first run: godot --headless --dump-extension-api)
addons/loki/harness/extension_api.json

# stray files an agent run may create in the plugin repo itself
plugins/

# Optional local Godot MCP addons (installed for this dev project only;
# not part of Loki - a consuming project still needs only addons/loki)
addons/godot_ai/
addons/godot_omni/
HANDOFF.md

# Laya local decision model (npm @receptron/laya + cached ONNX weights)
harness_data/laya/
harness_data/project_state.json
harness_data/agent_sessions.json
harness_data/api_vault_extra.json
harness_data/apis_guru.json
