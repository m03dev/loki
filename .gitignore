# Everything Loki writes at runtime lives in harness_data/ (or LOKI_DATA) - never commit it.
harness_data/

# Per-workspace chat state, if Loki is pointed at this checkout
.loki/

# Python
__pycache__/
*.pyc
.venv/

# Local secrets & runtime
*.token
*.log
cloud/.env
cloud/sessions.json

# Generated Godot API dump (optional game capability)
engine/extension_api.json

# Laya (npm @receptron/laya), if installed next to the engine
engine/node_modules/
engine/package.json
engine/package-lock.json

# Leftovers from the old Godot-addon layout and stray agent output
.godot/
/addons/
/scenes/
/scripts/
/plugins/
project.godot
# ...except LOKI World, the MMO (AGENTS.md: the one Godot project, game/loki-world/)
!game/loki-world/project.godot
.git-rewrite/

# Packaged builds and models
build/
dist/
*.gguf
*.safetensors

# A test suite cleans up its own temp dirs; a killed run must never be committed.
/loki-auto-*/
/loki-role-*/
/loki-systems-*/
/loki-tests-*/
/tmp*/

# Any test-suite temp dir in the repo root (covers future prefixes too).
/loki-*/

# test-suite temp dirs (underscore form: loki_eval_* etc.)
/loki_*/
.claude/worktrees/

# The Rust launcher (packaging/launcher) builds here
packaging/launcher/target/

# LOKI World's Godot web build (game/loki-world -> engine/world_build.py or Export -> Web) IS committed since
# 2026-10-18, so the World tab is the Godot game on every machine without building it first. The engine is kept
# gzipped (index.wasm.gz, served with Content-Encoding: gzip); the uncompressed one is never committed.
app/ui/world_godot/index.wasm
app/ui/world_godot/index.worker.js
