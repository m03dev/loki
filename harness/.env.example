# Loki API keys. Copy to .env and fill in the ones you have.
# All of these have free tiers - you only need one.
#
# Google AI Studio (Gemini)   https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
#
# Groq (fast, free tier)      https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#
# OpenRouter (free models)    https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
#
# Cerebras / Mistral / Together / DeepSeek (optional)
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
#
# OmniRoute local gateway (see docs/providers.md)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto
#
# Pick the model Loki uses by default: gemini | groq | openrouter | local-reasoning | omniroute | ...
LOKI_MODEL=local-reasoning
