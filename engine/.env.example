# Loki API keys. Copy this file to harness_data/.env and fill in what you have.
# Run  python tools/loki_doctor.py  any time to see what is configured and what to get.
#
# YOU NEED NONE OF THESE. Loki runs with zero keys: the "vireonix" provider below
# needs no key, no account and no card. Any key you add simply gets preferred over it.

# --- free tiers (add one; Loki tries them in this order) ---
# Google AI Studio (Gemini)   https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Groq (fast)                 https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# OpenRouter (free + paid)    https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# --- more free tiers ---
# SambaNova                   https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# Cloudflare Workers AI       https://dash.cloudflare.com  (account id required too)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Mistral                     https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Together                    https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=
# Nous Portal                 https://portal.nousresearch.com
NOUS_API_KEY=
# UnoRouter                   https://unorouter.com
UNOROUTER_API_KEY=

# --- optional paid ---
# DeepSeek V4.1-Flash         https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# OpenAI / Anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- zero-setup provider: leave this COMMENTED OUT ---
# Vireonix needs no key at all. Uncommenting it with an empty value would DISABLE
# it, so only set a value here if you have a real one.
# VIREONIX_API_KEY=

# --- local models (optional; needs Ollama:  ollama pull qwen3:8b) ---
# Nothing to set - they are used automatically when Ollama is running.

# --- local gateway (optional) ---
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=
# OMNIROUTE_MODEL=auto

# --- which provider Loki uses ---
# smart  = best available, falls back automatically (recommended; works with ZERO keys)
# online = same, but never a local model (no GPU / no Ollama)
# or name one:  gemini | groq | openrouter | deepseek | local-reasoning | claude-code | codex
LOKI_MODEL=smart

# --- optional ---
# GODOT_EXE=            path to your Godot 4 executable if it is not on PATH
# GAME_PROJECT=         the Godot project the agent should work on
# LOKI_MAX_TOKENS=8192
# LOKI_VERIFY=1                 check the files a request wrote before trusting DONE (0 = off)
# LOKI_VERIFY_FIX_ROUNDS=2      how many times real errors are sent back to the model
# LOKI_VERIFY_MAX_FILES=6       check at most this many changed files per request
# LOKI_PAID_MAX_CALLS=40        model calls per request on a PAID provider (free tiers are unaffected)
# LOKI_WORKERS_MAX=2            background agents running at once
# LOKI_WORKERS_MAX_DEPTH=2      how deep agents may delegate to agents
# LOKI_EXPERIENCE=1             log outcomes so Loki can learn (docs/agents-and-self-improvement.md)
# LOKI_LEARN_ROUTING=1          reorder providers by measured success, within a cost tier
# LOKI_TUNED_PROMOTED=0         set to 1 by tools/self_improve.py promote

# --- Jev (optional): typed decisions for the agent loop ---
# https://thejevai.com - a fast decision model (choice / score / noul) that the loop
# uses to gate risky tool calls and to notice when it is stuck. Loki works fully
# without it; with a key it auto-allows tool calls it judges safe, nudges the agent
# when it spins, and switches on the jev MCP decision tools. A hosted jv_live_ key or
# an official console.typesafe.ai key both work (the endpoint follows the key).
# TYPESAFE_API_KEY=
# JEV_MODEL=typesafe/jev-1.13
# LOKI_JEV_RISK=0.15
# LOKI_JEV=0        set to 0 to disable Jev even with a key

# --- Laya: the offline FIRST LAYER ---
# https://github.com/receptron/laya - the open-source, Jev-compatible System-1 decision
# model (weights by Convai Innovations, Apache-2.0). Every request is triaged by Laya first
# (kind, route, difficulty, risk); it also gates risky tool calls and spots loops. It runs
# entirely on this machine. Setup installs it; to (re)install by hand (Node 20+):
#     python tools/setup_laya.py          (downloads ~1.7 GB once into harness_data/laya)
#     python tools/setup_laya.py --check  (what is installed)
# Without it, Loki's built-in rules answer instead and the conversation says so.
# LOKI_LAYA_LOCAL=1              0 turns the local model off
# LOKI_LAYA_MODEL_DIR=           use a local ONNX export instead of the downloaded weights
# LOKI_LAYA_RISK=0.15
# LOKI_LAYA_TIMEOUT=30           seconds per decision once the model is loaded
# LOKI_LAYA_IDLE=1800            seconds idle before the warm model is unloaded (~2 GB RAM)
# LOKI_TRIAGE_TIMEOUT=8          how long a request waits for Laya before the rules answer
# LOKI_SKIP_LAYA=1               setup skips installing Laya
# Or use a hosted, Jev-compatible endpoint instead:
# LAYA_BASE_URL=
# LAYA_API_KEY=
#
# Which provider is asked first (Laya is local-first by default):
# LOKI_DECISION_ORDER=laya,jev

# --- more free tiers (from github.com/mnfst/awesome-free-llm-apis) ---
# OpenAI-compatible endpoints. Set a key, then LOKI_MODEL=<name> (or leave it smart).
# Aion Labs                     https://www.aionlabs.ai/app/api-keys/
# AION_API_KEY=
# Cohere (free trial key)       https://dashboard.cohere.com/api-keys
# COHERE_API_KEY=
# Z AI / Zhipu (GLM)            https://open.bigmodel.cn/usercenter/apikeys
# ZAI_API_KEY=
# Hugging Face router           https://huggingface.co/settings/tokens
# HF_TOKEN=
# Kilo Code                     https://app.kilo.ai/profile
# KILOCODE_API_KEY=
# LLM7.io (works with no key)   https://token.llm7.io
# LLM7_API_KEY=
# ModelScope                    https://modelscope.cn/my/myaccesstoken
# MODELSCOPE_API_KEY=
# NVIDIA NIM                    https://build.nvidia.com/explore/discover
# NVIDIA_API_KEY=
# Ollama Cloud                  https://ollama.com/settings/keys
# OLLAMA_API_KEY=
# OVHcloud AI Endpoints         https://www.ovhcloud.com/en/public-cloud/ai-endpoints/
# OVH_API_KEY=
# SiliconFlow                   https://cloud.siliconflow.cn/account/ak
# SILICONFLOW_API_KEY=

# ---- safety ceilings (hold even when LOKI_MAX_TURNS / LOKI_REQUEST_DEADLINE are 0) ----
# LOKI_HARD_MAX_TURNS=400        # model<->tool cycles per request
# LOKI_HARD_DEADLINE=21600       # seconds per request (6 h)
# LOKI_MODEL_TIMEOUT=180         # seconds per model HTTP call
# LOKI_NET_ALLOW=                # extra hosts capabilities may reach, comma-separated

# ---- Ollama on other machines (enable "ollama-fleet" in Settings > Capabilities) ----
# On the worker: OLLAMA_HOST=0.0.0.0 ollama serve ; ollama pull qwen2.5-coder:7b
# LOKI_WORKERS=pc=http://192.168.1.50:11434,mac=http://127.0.0.1:11434

# ---- background jobs ----
# LOKI_JOB_CLAUDE_MODE=acceptEdits   # Claude Code permission mode for jobs
# LOKI_CUA_PROVIDER=lume             # lume (macOS VM) | docker (Linux desktop)
# LOKI_CUA_IMAGE=
# LOKI_CUA_MODEL=                    # computer-use model for VM agent jobs

# ---- specialists (Loki the conductor; enable each in Settings > Capabilities) ----
# PERPLEXITY_API_KEY=                # research
# LOKI_PERPLEXITY_MODEL=sonar
# LOKI_READ_ORDER=crawl4ai,scrapling,firecrawl
# LOKI_FIRECRAWL_URL=http://localhost:3002
# LOKI_BROWSE_MODEL=                 # browse (Browser Use); OpenAI-compatible
# LOKI_BROWSE_BASE_URL=
# LOKI_BROWSE_API_KEY=
# HINDSIGHT_URL=http://localhost:8888
# LOKI_HINDSIGHT_BANK=loki
# LOKI_OBSIDIAN_VAULT=               # brain map: your vault, read-only

# --- Spending (docs/VISION.md 6) ---
# Automatic routing never uses a paid provider unless you allow it; paid use stops for the
# day at the dollar limit (from harness_data/usage.jsonl), even for a model you picked.
# LOKI_ALLOW_PAID=0
# LOKI_DAILY_USD_LIMIT=1.0
# LOKI_PAID_MAX_CALLS=40         paid model calls per request

# --- LOKI improving itself ---
# LOKI_SELF_SHIP=auto            auto | ask | off (improve_loki / ship_loki; ship.py needs green tests)
# LOKI_AUTO_UPDATE=1             update from GitHub on start (0 = never)
# LOKI_UPDATE_EVERY_S=1800       how often a running LOKI checks GitHub
