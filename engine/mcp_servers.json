{
  "mcpServers": {
    "time": {
      "command": "uvx",
      "args": [
        "mcp-server-time"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "godot": {
      "requires_env": "GAME_PROJECT",
      "command": "uvx",
      "args": [
        "godot-editor-mcp"
      ],
      "toolsets": []
    },
    "jev": {
      "command": "uvx",
      "args": [
        "jev-mcp-server"
      ],
      "requires_env": "TYPESAFE_API_KEY"
    },
    "godot_run": {
      "requires_env": "GAME_PROJECT",
      "command": "npx",
      "args": [
        "-y",
        "@coding-solo/godot-mcp"
      ],
      "requires_cmd": "npx"
    },
    "godot_omni": {
      "url": "http://127.0.0.1:8000/mcp",
      "transport": "streamable-http",
      "auth_bearer_json": {
        "path": "${GODOT_AI_CAPABILITY_DIR}/http-8000.json",
        "key": "http"
      },
      "enabled": false,
      "note": "Owned by the Godot editor plugin (addons/godot_ai + addons/godot_omni). Loki reads the editor's per-launch capability token and connects over HTTP; it must NOT spawn godot-ai itself or the two fight over ports 8000/9500 and kill the editor."
    },
    "godot_runtime": {
      "command": "npx",
      "args": [
        "-y",
        "godot-mcp-runtime"
      ],
      "requires_cmd": "npx",
      "enabled": false,
      "note": "39 tools: launch/run/attach a project and read debug output."
    },
    "godot_enhanced": {
      "command": "npx",
      "args": [
        "-y",
        "godot-mcp-enhanced"
      ],
      "requires_cmd": "npx",
      "enabled": false,
      "note": "26 tools: runtime, screenshots and script/scene validation.",
      "cwd": "${LOKI_DATA}"
    },
    "better_godot": {
      "command": "npx",
      "args": [
        "-y",
        "@n24q02m/better-godot-mcp"
      ],
      "requires_cmd": "npx",
      "enabled": false,
      "note": "17 tools: project/scene/node/script/editor/config. Needs Node >= 24.",
      "cwd": "${LOKI_DATA}"
    },
    "godot_scene": {
      "command": "npx",
      "args": [
        "-y",
        "@satelliteoflove/godot-mcp"
      ],
      "requires_cmd": "npx",
      "enabled": false,
      "note": "21 tools: scene/node/editor read+edit.",
      "cwd": "${LOKI_DATA}"
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "${LOKI_WORKSPACE}"
      ],
      "requires_cmd": "uvx",
      "enabled": false
    },
    "sequential": {
      "command": "uvx",
      "args": [
        "mcp-sequential-thinking"
      ],
      "requires_cmd": "uvx",
      "enabled": false
    },
    "ruflo": {
      "command": "npx",
      "args": [
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "requires_cmd": "npx",
      "enabled": false,
      "note": "Ruflo (github.com/ruvnet/ruflo, MIT): swarm, memory and agent tools. Opt in with LOKI_MCP_ENABLE=ruflo."
    },
    "penecho": {
      "command": "penecho",
      "args": [
        "mcp"
      ],
      "requires_cmd": "penecho",
      "enabled": false,
      "capability": "penecho",
      "note": "PenEcho (github.com/penecho/penecho, AGPL-3.0, a separate program): shared drawing canvas on http://localhost:3888. Starts when penecho is installed (npm i -g penecho) and turned on in Settings > Add-ons, or with LOKI_MCP_ENABLE=penecho."
    },
    "openhuman": {
      "command": "openhuman-core",
      "args": [
        "mcp"
      ],
      "requires_cmd": "openhuman-core",
      "enabled": false,
      "capability": "openhuman",
      "note": "OpenHuman (github.com/tinyhumansai/openhuman, GPL-3.0, a separate program): stdio MCP server. Starts when openhuman-core is on PATH and turned on in Settings > Add-ons, or with LOKI_MCP_ENABLE=openhuman."
    }
  }
}
