    "expo-camera": "~17.0.0",
    "expo-dev-client": "~6.0.0",
    "expo-device": "~8.0.0",
    "expo-file-system": "~19.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "llama.rn": "latest",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-nitro-modules": "latest",
    "react-native-safe-area-context": "~5.6.0"
  },
  "devDependencies": {
