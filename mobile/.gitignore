# The repo root ignores every "scripts/" (old Godot layout); this app's scripts are code.
!scripts/

# Expo / React Native - never commit installs, native projects made by prebuild, or builds
node_modules/
.expo/
dist/
web-build/
ios/
android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
.env*.local
npm-debug.*
yarn-error.*
*.tsbuildinfo
# on-device models are downloaded by the app, never committed
*.gguf
*.cact
