{
  "expo": {
    "name": "LOKI",
    "slug": "loki",
    "scheme": "loki",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b1220",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.m03.loki",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "LOKI uses the camera only to scan the pairing code shown by LOKI on your Mac or PC.",
        "NSLocalNetworkUsageDescription": "LOKI talks to LOKI on your own Mac or PC over your home network.",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "dev.m03.loki",
      "permissions": ["android.permission.CAMERA", "android.permission.INTERNET"],
      "adaptiveIcon": { "backgroundColor": "#0b1220" }
    },
    "plugins": [
      ["expo-camera", { "cameraPermission": "LOKI uses the camera only to scan the pairing code shown by LOKI on your Mac or PC." }],
      "expo-secure-store",
      ["expo-build-properties", {
        "android": { "usesCleartextTraffic": true, "minSdkVersion": 26 },
        "ios": { "deploymentTarget": "15.1" }
      }]
    ]
  }
}
