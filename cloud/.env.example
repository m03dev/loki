# Loki Cloud auth service. Copy to .env and fill in.
# Create these at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL of THIS service (used as the Google redirect URI).
# Register  <BASE_URL>/auth/google/callback  as an Authorized redirect URI
# on the OAuth client.
LOKI_CLOUD_BASE_URL=http://localhost:8788
LOKI_CLOUD_PORT=8788
